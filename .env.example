# Required when IRMIK_ENV=production (Docker / Dokploy).
IRMIK_JWT_SECRET=change-me-to-a-long-random-string

# Optional: public site origin. HTML already ships absolute goirmik.org OG tags;
# set this on Dokploy (or other hosts) so og:url / og:image rewrite for that domain.
SITE_URL=https://goirmik.org
